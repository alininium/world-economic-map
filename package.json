    "data:geo": "tsx pipeline/refresh.ts geo",
    "data:check": "tsx pipeline/check.ts"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
